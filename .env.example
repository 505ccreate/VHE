# Correction Studio — service credentials (VHE-ISSUE-LOG-0011 hosted dev route).
# Copy to .env and fill in. NEVER commit .env — keys live in the owner's central
# API-key library and are granted per room (VHE-ISSUE-LOG-0006).

# Supabase (or other hosted Postgres 16) — connection string with password
DATABASE_URL=

# Hosted Redis-protocol service (Upstash etc.), redis:// or rediss:// URL
REDIS_URL=

# S3-compatible storage (Supabase Storage / Cloudflare R2)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# VHE-2 §9.5 native decoded-frame memory ceiling (4 GiB; configure per worker host)
VHE_REPAIR_MEMORY_CEILING_BYTES=4294967296
